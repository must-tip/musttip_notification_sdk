{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.musttip.example/notifications/event-envelope-v1.json",
  "title": "Must Tip Communication Event Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "source",
    "topic",
    "occurred_at",
    "data"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "schema_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "topic": {
      "type": "string",
      "minLength": 1,
      "maxLength": 249
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "trace_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 256
    },
    "correlation_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 256
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 256
    },
    "tenant_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 255
    },
    "headers": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "maxProperties": 64
    },
    "data": {}
  }
}
