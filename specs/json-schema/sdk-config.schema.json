{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.musttip.example/notifications/sdk-config-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "base_url"
  ],
  "properties": {
    "base_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "timeout_seconds": {
      "type": "number",
      "minimum": 0.1,
      "maximum": 300
    },
    "maximum_attempts": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "maximum_response_bytes": {
      "type": "integer",
      "minimum": 4096,
      "maximum": 16777216
    },
    "user_agent_suffix": {
      "type": "string",
      "maxLength": 128
    }
  }
}
